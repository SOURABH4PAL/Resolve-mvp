# Database
DATABASE_URL=postgresql://resolvehub_user:resolvehub_pass@localhost:5432/resolvehub

# JWT
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# App
ENVIRONMENT=development
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# CORS (comma-separated origins; explicit origins only, no wildcard with credentials)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000
