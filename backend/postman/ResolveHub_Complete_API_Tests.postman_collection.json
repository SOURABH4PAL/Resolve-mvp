    {
      "name": "04. Tickets Lifecycle & Priority (Req 03 & 11)",
      "item": [
        {
          "name": "Create CRITICAL Ticket [Positive]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{employee_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"Data Center Power Loss\", \"description\": \"Rack 4 loses UPS redundancy\", \"category_id\": \"{{test_category_id}}\", \"priority\": \"CRITICAL\"}"
            },
            "url": "{{base_url}}/api/tickets"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201 Created', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.test('Priority is CRITICAL and SLA assigned', function () {",
                  "    pm.expect(json.priority).to.eql('CRITICAL');",
                  "    pm.expect(json).to.have.property('response_due_at');",
                  "    pm.expect(json).to.have.property('resolution_due_at');",
                  "    pm.expect(json.sla_status).to.eql('IN_SLA');",
                  "});",
                  "pm.environment.set('test_ticket_id', json.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Ticket Blank Title [Negative]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{employee_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"   \", \"description\": \"Valid description\", \"category_id\": \"{{test_category_id}}\", \"priority\": \"LOW\"}"
            },
            "url": "{{base_url}}/api/tickets"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 422 Unprocessable Entity', function () { pm.response.to.have.status(422); });"
                ]
              }
            }
          ]
        },
