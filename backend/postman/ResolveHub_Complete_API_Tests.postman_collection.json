          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 422 Unprocessable Entity', function () { pm.response.to.have.status(422); });"
                ]
              }
            }
          ]
        },
