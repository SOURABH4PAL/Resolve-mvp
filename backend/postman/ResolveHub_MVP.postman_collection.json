    {
      "name": "Attachments (Requirement 1)",
      "item": [
        {
          "name": "1. Single File Upload (Success)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.environment.set('test_attachment_id', jsonData.id);",
                  "pm.test('Response does NOT expose file_path', function () {",
                  "    pm.expect(jsonData.file_path).to.be.undefined;",
                  "});",
                  "pm.test('Has file_name and size', function () {",
                  "    pm.expect(jsonData.file_name).to.be.a('string');",
                  "    pm.expect(jsonData.file_size).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{employee_token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "sample_document.pdf"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/tickets/{{test_ticket_id}}/attachments",
              "host": [
                "{{base_url}}"
